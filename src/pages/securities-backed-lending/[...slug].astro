---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const pillars = await getCollection('pillars', (entry) => entry.data.category === 'SBL');
  return pillars.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;
const url = `https://sydneywestrick.com/securities-backed-lending/${entry.slug}/`;

const aboutThings: any[] = [
  data.aboutTopicSameAs
    ? { "@type": "Thing", "name": data.aboutTopic, "sameAs": data.aboutTopicSameAs }
    : { "@type": "Thing", "name": data.aboutTopic }
];
if (data.category === 'SBL') {
  aboutThings.push({ "@type": "Thing", "name": "Concentrated Stock Position" });
}

const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${url}#article`,
  "headline": data.title,
  "description": data.standfirst,
  "author": { "@id": "https://sydneywestrick.com/#person" },
  "publisher": { "@id": "https://sydneywestrick.com/#org" },
  "datePublished": data.publishedDate,
  "dateModified": data.modifiedDate,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": url
  },
  "image": `${url}og.jpg`,
  "about": aboutThings,
  "audience": {
    "@type": "Audience",
    "audienceType": data.audience
  },
  "wordCount": data.wordCount,
  "keywords": data.keywords,
  "isPartOf": { "@id": "https://sydneywestrick.com/#website" }
};

const faqPage = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": data.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://sydneywestrick.com" },
    { "@type": "ListItem", "position": 2, "name": "Securities-Backed Lending", "item": "https://sydneywestrick.com/securities-backed-lending/" },
    { "@type": "ListItem", "position": 3, "name": data.title }
  ]
};

const formatDate = (iso: string) =>
  new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', {
    month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC'
  });
---
<BaseLayout
  title={`${data.title} · The Liquidity Desk`}
  description={data.standfirst}
  activeNav="pillars"
>
  <Fragment slot="page-schema">
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqPage)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </Fragment>

  <section class="article-page">
    <div class="container">
      <div class="article-breadcrumb">
        <a href="/">Home</a> · <a href="/pillars">Pillars</a> · <a href="/pillars">Securities-Backed Lending</a> · {data.title}
      </div>
      <div class="article-eyebrow">{data.pillarNumber} · Securities-Backed Lending</div>
      <h1>{data.title}</h1>
      <p class="article-standfirst">{data.standfirst}</p>
      <div class="article-meta">
        <div><strong>Published</strong> {formatDate(data.publishedDate)}</div>
        <div><strong>Updated</strong> {formatDate(data.modifiedDate)}</div>
        <div><strong>Reading time</strong> {data.readingTime}</div>
        <div><strong>Audience</strong> {data.audience}</div>
      </div>

      <div class="article-toc">
        <div class="toc-label">Sections in this pillar</div>
        <ol>
          {data.sections.map((s) => <li>{s}</li>)}
        </ol>
      </div>

      <div class="article-body">
        <Content />
      </div>

      <div class="faq-section">
        <h2>Frequently asked</h2>
        {data.faqs.map((faq) => (
          <div class="faq-item">
            <h3>{faq.question}</h3>
            <p>{faq.answer}</p>
          </div>
        ))}
      </div>

      <div class="sources-section">
        <h3>Sources</h3>
        <ol>
          {data.sources.map((s) => <li>{s}</li>)}
        </ol>
      </div>

      <div style="margin-top: 64px; padding: 32px; background: var(--cream); border: 1px solid var(--line); text-align: center;">
        <div class="eyebrow" style="color: var(--gold); margin-bottom: 12px;">Continue Reading</div>
        <h3 style="font-family: 'Fraunces', serif; font-variation-settings: 'opsz' 144; font-size: 24px; margin-bottom: 8px; font-weight: 600;">Subscribe to The Liquidity Desk</h3>
        <p style="color: var(--sage); font-size: 15px; margin-bottom: 20px;">Weekly newsletter for advisors who allocate to specialized credit. Free.</p>
        <a href="/liquidity-desk" style="display: inline-block; padding: 14px 28px; background: var(--rust); color: var(--cream); font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase;">Subscribe →</a>
      </div>
    </div>
  </section>
</BaseLayout>
